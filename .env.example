# Copy to .env locally. Never commit real secrets.

# Worker market data
TWELVE_DATA_API_KEY=

# Optional primary economic-calendar provider.
# If unavailable or plan-gated, TBOT automatically falls back to FinanceCalendar.
FMP_API_KEY=

# Recommended for any hosted private-demo web service.
# These protect the dashboard/API with HTTP Basic authentication.
TBOT_DASHBOARD_USERNAME=
TBOT_DASHBOARD_PASSWORD=
